#:import parse_color kivy.parser.parse_color
#:import AppHomeBox screens.mainScr.AppHomeBox
#:import SettingsBox screens.settings.SettingsBox
#:import LogBox screens.logs.LogBox
#:import HistoriqueBox screens.historiqueScr.HistoriqueBox
#:import t screens.theme

<BaseMDNavigationItem>
    MDNavigationItemIcon:
        icon: root.icon
    MDNavigationItemLabel:
        text: root.text

MDScreen:
    md_bg_color: t.FOND

    MainScreenBox: # main container
        id: main_scr_box
        orientation: 'vertical'
        padding: 0 , self.top_pad, 0, 0

        # Bandeau aux couleurs de Kelaplus : dégradé indigo → violet → magenta, logo k+.
        MDBoxLayout:
            size_hint_y: None
            height: dp(64)
            padding: dp(6), 0, dp(12), 0
            spacing: dp(6)
            canvas.before:
                Color:
                    rgba: 1, 1, 1, 1
                Rectangle:
                    pos: self.pos
                    size: self.size
                    texture: app.degrade_marque

            MDIconButton:
                icon: "menu"
                theme_icon_color: "Custom"
                icon_color: "white"
                pos_hint: {"center_y": .5}
                on_release: nav_drawer.set_state("toggle")
            MDIconButton:
                id: top_back_btn
                icon: "arrow-left"
                theme_icon_color: "Custom"
                icon_color: "white"
                pos_hint: {"center_y": .5}
                opacity: 0
                disabled: True
                size_hint_x: None
                width: 0 if self.disabled else dp(48)
                on_release: app.back_button_action()
            Image:
                source: "data/images/favicont512.png"
                size_hint: None, None
                size: dp(38), dp(38)
                pos_hint: {"center_y": .5}
            MDBoxLayout:
                orientation: "vertical"
                adaptive_height: True
                pos_hint: {"center_y": .5}
                padding: dp(6), 0, 0, 0
                MDLabel:
                    text: "Kelaplus SMS"
                    font_style: "Title"
                    role: "large"
                    bold: True
                    theme_text_color: "Custom"
                    text_color: "white"
                    adaptive_height: True
                MDLabel:
                    text: "Le téléphone SMS de l'école"
                    font_style: "Label"
                    role: "medium"
                    theme_text_color: "Custom"
                    text_color: 1, 1, 1, .85
                    adaptive_height: True
            MDIconButton:
                id: right_dot_menu
                icon: "dots-vertical"
                theme_icon_color: "Custom"
                icon_color: "white"
                pos_hint: {"center_y": .5}
                opacity: 0
                disabled: True

        MDFloatLayout:

            MDNavigationLayout:

                MDScreenManager:
                    id: screen_manager

                    MDScreen:
                        name: "Accueil"
                        on_enter: app.on_main_screen_entry()
                        AppHomeBox:
                            id: home_scr
                            padding: dp(12), 0, dp(12), (main_scr_box.bottom_pad + btm_nav_bar.height + 2)

                    MDScreen:
                        name: "Historique"
                        on_enter: hist_scr.a_l_ouverture()
                        on_leave: hist_scr.a_la_sortie()
                        HistoriqueBox:
                            id: hist_scr
                            padding: dp(12), 0, dp(12), (main_scr_box.bottom_pad + btm_nav_bar.height + 2)

                    MDScreen:
                        name: "Réglages"
                        on_enter: app.on_settings_entry()
                        SettingsBox:
                            id: settings_scr
                            padding: dp(12), dp(12), dp(12), (main_scr_box.bottom_pad + btm_nav_bar.height + 2)

                    MDScreen:
                        name: "Journal"
                        on_enter: log_scr.log_show(right_dot_menu, top_back_btn)
                        on_leave: log_scr.on_log_scr_exit(right_dot_menu)
                        LogBox:
                            id: log_scr
                            padding: dp(12), dp(8), dp(12), (main_scr_box.bottom_pad + btm_nav_bar.height + 2)

                MDNavigationDrawer:
                    id: nav_drawer
                    radius: 0, dp(16), dp(16), 0

                    MDNavigationDrawerMenu:
                        MDNavigationDrawerLabel:
                            text: "Kelaplus SMS"
                        MDNavigationDrawerItem:
                            on_release: app.goto_logs_screen()
                            MDNavigationDrawerItemLeadingIcon:
                                icon: "text-box-outline"
                            MDNavigationDrawerItemText:
                                text: "Journal technique"
                        MDNavigationDrawerDivider:

            MDNavigationBar:
                id: btm_nav_bar
                pos: 0, main_scr_box.bottom_pad
                on_switch_tabs: app.on_switch_tabs(*args)

                BaseMDNavigationItem
                    icon: "home-variant-outline"
                    text: "Accueil"
                    active: True

                BaseMDNavigationItem
                    icon: "message-text-clock-outline"
                    text: "Historique"

                BaseMDNavigationItem
                    icon: "cog-outline"
                    text: "Réglages"
